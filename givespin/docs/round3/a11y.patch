diff -ruN base/givespin/tests/sections/33-a11y.mjs work/givespin/tests/sections/33-a11y.mjs
--- base/givespin/tests/sections/33-a11y.mjs	1970-01-01 00:00:00.000000000 +0000
+++ work/givespin/tests/sections/33-a11y.mjs	2026-11-04 19:53:41.405342862 +0000
@@ -0,0 +1,304 @@
+// Keyboard stops, touch targets and overflow left over from the review and the second walk-through (sections 33a to 33d). Each section guards one thing.
+//   33a  a live table's feed: all the bot names are ONE tab stop (arrow keys, Home, End), Enter or Space opens the profile, a mouse still reaches every name, focus comes back
+//   33b  touch targets of at least 24 x 24 CSS px (WCAG 2.5.8) for the links, buttons and names the review and the walk found too small
+//   33c  the receipt dialog cannot be panned sideways on a phone (a single gift and a split one), and the line under its buttons is not hidden by them
+//   33d  Stream Mode's see-through ?overlay=1 page fits a short window; toasts on a short window do not cover the picture or the result
+// Run one with ONLY=33a (the filter takes whole ids, not the prefix).
+import fs from 'node:fs';
+
+export default async function (h) {
+  const { check, newPage, openApp, go, section, problems, waitReceipt, closeReceipt } = h;
+  const AXE = process.env.AXE && fs.existsSync(process.env.AXE) ? fs.readFileSync(process.env.AXE, 'utf8') : null;
+
+  // a save as an older version wrote it (a total given, in cents, and the XP that earns), put in place once per page
+  const saveOf = (cents) => ({ v: 2, xp: Math.floor(cents / 10), totalCents: cents, plays: 20, streak: 2, bestStreak: 4 });
