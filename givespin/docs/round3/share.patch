+test('the crew card is drawn with the share cards\' own drawing pieces, not a copy of them', () => {
+  const root = path.join(__dirname, '..', 'js', 'ui');
+  const boards = fs.readFileSync(path.join(root, 'boards.js'), 'utf8');
+  const card = fs.readFileSync(path.join(root, 'sharecard.js'), 'utf8');
+  ['roundRect', 'glowAt', 'fitText', 'measurer', 'fontsReady', 'toBlob', 'goldFrame', 'plainFrame', 'header', 'ribbon', 'text'].forEach((fn) => {
+    assert.ok(!new RegExp('function ' + fn + '\\(').test(boards), 'js/ui/boards.js has no copy of ' + fn + '()');
+    assert.ok(new RegExp('function ' + fn + '\\(').test(card), 'js/ui/sharecard.js has ' + fn + '()');
+  });
+  assert.match(card, /draw: \{[^}]*roundRect: roundRect[^}]*toBlob: toBlob/, 'and it hands them out as ui.sharecard.draw');
+  assert.ok(!/HEART\s*=/.test(boards) && !/"Sora"/.test(boards), 'no second copy of the logo heart or the fonts');
+  assert.ok(boards.indexOf('ui.sharecard.draw') > 0 && /D\.footer\(/.test(boards), 'the crew card uses them');
+  const html = fs.readFileSync(path.join(__dirname, '..', 'index.html'), 'utf8');
+  assert.ok(html.indexOf('js/ui/sharecard.js') > 0 && html.indexOf('js/ui/sharecard.js') < html.indexOf('js/ui/boards.js'), 'sharecard.js is loaded before boards.js');
