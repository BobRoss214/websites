+test('the season card names no one unless the name switch is on, and carries no amount of money', () => {
+  const plain = share.seasonCard({ demo: true, season: SEASON, tier: 14, questsDone: 9 });
+  const named = share.seasonCard({ demo: true, season: SEASON, tier: 14, questsDone: 9, name: 'Sam' });
+  assert.equal(plain.name, '');
+  assert.equal(named.eyebrow, 'Sam’s season');
+  assert.ok(!/Sam/.test(share.shareText(plain) + share.altText(plain, 'portrait')));
+  assert.match(share.shareText(named), /^Sam’s GiveSpin season, Gold November: tier 14 of 30, 9 quests done \(XP and cosmetics only, never money\)\. Give it a spin:$/);
+  assert.equal(share.seasonCard({ season: SEASON, tier: 3, name: 'a@b.co' }).name, '', 'an email is never a name');
+  const everything = JSON.stringify(plain) + share.shareText(plain) + share.altText(plain, 'square');
+  assert.ok(!/\$/.test(everything), 'no amount of money anywhere on the season card');
+  const alt = share.altText(plain, 'square');
+  assert.match(alt, /square \(1080 by 1080\)/);
