+  assert.match(alt, /XP and cosmetics only, never money/);
+  assert.match(share.altText(share.seasonCard({ season: SEASON, tier: 30 }), 'portrait'), /Gold frame: Season complete/);
+  assert.equal(share.fileName('season', '2026-11', 'square'), 'givespin-season-2026-11-square.png');
+  assert.equal(share.fileName('season', '', 'portrait'), 'givespin-season-portrait.png');
+  assert.equal(share.fileName('season', '../x', 'portrait'), 'givespin-season-portrait.png', 'an odd id is dropped');
+});
