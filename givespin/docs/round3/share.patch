+const BANNED = /crypto(?!graphic)|bitcoin|ethereum|blockchain|wallet|\bNFTs?\b|\btokens?\b|\bcoins?\b/i;   // the site's own wording ban (see the end-to-end suite)
+const SEASON = { id: '2026-11', name: 'Gold November', month: 'November 2026' };
+const live = (o) => base(Object.assign({ live: true, game: 'Balloon Race · Big · 100 balloons' }, o || {}));
+
+test('a live table\'s card says it is a simulated table with bot players, and is always a play-money card', () => {
+  const card = share.roundCard(live());
+  assert.equal(card.live, true);
+  assert.match(card.eyebrow, /simulated table/);
+  assert.match(card.note, /Simulated round: no money moved and nothing was charged/, 'the receipt\'s own sentence');
+  assert.match(card.note, /Simulated table: every other player is a BOT/);
+  assert.equal(card.game, 'Balloon Race · Big · 100 balloons', 'the table\'s game and size are on the card');
+  const alt = share.altText(card, 'portrait');
+  assert.match(alt, /simulated table game: Balloon Race · Big · 100 balloons/);
+  assert.match(alt, /every other player is a BOT/);
+  assert.match(share.shareText(card), /^My GiveSpin simulated table round \(bot players\) landed on WaterAid \(play money\)\./);
+  // even when the page says it is not in demo mode, a live table is demo credit and bots: it never reads as real money
+  const checkout = share.roundCard(live({ demo: false }));
+  assert.equal(checkout.demo, true);
+  assert.equal(checkout.lead, 'went to');
+  assert.match(checkout.note, /nothing was charged/);
+  // a solo card is not changed by any of this
+  const solo = share.roundCard(base());
+  assert.equal(solo.live, false);
+  assert.equal(solo.eyebrow, 'A gift from the arcade');
+  assert.equal(solo.note, 'Simulated round: no money moved and nothing was charged');
+  assert.ok(!/simulated table/i.test(share.altText(solo, 'portrait') + share.shareText(solo)));
+});
+
+test('a live card keeps the same name rules and the same verify code as a solo one', () => {
+  assert.equal(share.roundCard(live()).name, '', 'no name unless one is passed in');
+  assert.equal(share.roundCard(live()).eyebrow, 'A gift from a simulated table');
+  const named = share.roundCard(live({ name: 'Sam' }));
+  assert.equal(named.eyebrow, 'Sam’s gift from a simulated table');
+  assert.match(share.shareText(named), /^Sam’s GiveSpin simulated table round/);
+  assert.equal(share.roundCard(live({ name: 'sam@example.com' })).name, '', 'an email is never a name');
+  const v = share.roundCard(live()).verify;
+  assert.equal(v.text, 'Verify this round: 3f9a1c07 · GS-7K2M9Q');
+  assert.equal(share.roundCard(live({ fair: null })).verify, null, 'a live round with no draw to check has no verify line');
+  assert.equal(share.roundCard(live({ pickWon: true })).ribbon, 'Called it', 'a backed charity that won is the same fancy frame as in a solo game');
+  assert.ok(!share.shareText(share.roundCard(live({ fair: { serverHash: HASH, roundSeed: 'SECRETSEED'.repeat(6) } }))).includes('SECRETSEED'));
+});
