+test('the season card: the season, the tier, the quests done, and "XP and cosmetics only, never money"', () => {
+  const card = share.seasonCard({ demo: true, season: SEASON, tier: 14, questsDone: 9 });
+  assert.equal(card.kind, 'season');
+  assert.equal(card.seasonName, 'Gold November');
+  assert.equal(card.month, 'November 2026');
+  assert.equal(card.tierLine, 'Tier 14 of 30');
+  assert.equal(card.questsLine, '9 quests done');
+  assert.equal(card.eyebrow, 'My season');
+  assert.match(card.note, /^XP and cosmetics only, never money/);
+  assert.match(card.note, /Play money: nothing was charged/, 'the demo says nothing real moved');
+  assert.equal(card.demo, true);
+  assert.equal(card.big, '', 'a season that is not finished gets the plain frame');
+  assert.equal(card.verify, null);
+  assert.equal(share.seasonCard({ demo: false, season: SEASON, tier: 14, questsDone: 9 }).note, 'XP and cosmetics only, never money', 'outside the demo it still says it is never money');
+  assert.equal(share.seasonCard({ season: SEASON, tier: 12, questsDone: 1 }).questsLine, '1 quest done', 'one quest is singular');
+  assert.equal(share.seasonCard({ season: SEASON, tier: 12, questsDone: 0 }).questsLine, '0 quests done');
+  const all = share.seasonCard({ demo: true, season: SEASON, tier: 30, questsDone: 40 });
+  assert.equal(all.big, 'season');
+  assert.equal(all.ribbon, 'Season complete', 'finishing the whole track earns the gold frame');
+  assert.equal(share.seasonCard({ season: SEASON, tier: 99, questsDone: -4 }).tier, 30, 'a tier past the end is the last one');
+  assert.equal(share.seasonCard({ season: SEASON, tier: -3 }).tierLine, 'Tier 0 of 30');
+  assert.equal(share.seasonCard({}).seasonName, 'Season', 'a missing season still has a name');
+  assert.equal(share.seasonCard().tierLine, 'Tier 0 of 30');
+});
