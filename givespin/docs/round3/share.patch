+test('the words of the new cards break none of the wording rules', () => {
+  const cards = [
+    share.roundCard(live({ name: 'Sam', pickWon: true })), share.roundCard(live({ demo: false })),
+    share.seasonCard({ demo: true, season: SEASON, tier: 30, questsDone: 3, name: 'Sam' }), share.seasonCard({ demo: false, season: SEASON, tier: 12, questsDone: 3 })
