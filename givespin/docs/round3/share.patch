+test('"Share my season" shows once any tier of 10 or more has been claimed', () => {
+  const t = (tier, status) => ({ tier, status });
+  assert.equal(share.seasonShareable([]), false);
+  assert.equal(share.seasonShareable(undefined), false);
+  assert.equal(share.seasonShareable([t(1, 'claimed'), t(9, 'claimed'), t(10, 'ready'), t(11, 'locked')]), false, 'reaching tier 10 is not enough: it has to be claimed');
+  assert.equal(share.seasonShareable([t(1, 'claimed'), t(10, 'claimed')]), true);
+  assert.equal(share.seasonShareable([t(12, 'claimed'), t(10, 'ready')]), true, 'tiers can be claimed in any order');
+  assert.equal(share.seasonShareable([t(30, 'claimed')]), true);
+  assert.equal(share.seasonShareable([null, {}, t(NaN, 'claimed')]), false, 'odd input is not a claimed tier');
+  assert.equal(share.SEASON_MIN_TIER, 10);
+  assert.equal(share.SEASON_TIERS, 30);
+});
+
+test('quests done in a season are counted from the claim keys: dailies by their day, weeklies by the month of their Thursday', () => {
+  const claimed = {
+    'd:2026-11-02:d-live': true, 'd:2026-11-03:d-wheel': true, 'd:2026-10-31:d-rounds3': true,   // two in November, one in October
+    'w:2026-W45:w-days4': true,    // Mon 2 Nov to Sun 8 Nov: Thursday 5 Nov
+    'w:2026-W44:w-cup': true,      // Mon 26 Oct to Sun 1 Nov: Thursday 29 Oct, so October
+    's:2026-11:07': true,          // a tier, not a quest
+    'd:2026-11-04:d-back': false   // seen but not claimed
+  };
+  assert.equal(share.seasonQuestsDone(claimed, '2026-11'), 3);
+  assert.equal(share.seasonQuestsDone(claimed, '2026-10'), 2);
+  assert.equal(share.seasonQuestsDone(claimed, '2026-12'), 0);
+  // the ISO year edges: week 1 of 2025 starts on Monday 30 Dec 2024 but its Thursday is 2 Jan 2025; week 53 of 2026 ends on Sunday 3 Jan 2027, Thursday 31 Dec 2026
+  assert.equal(share.seasonQuestsDone({ 'w:2025-W01:w-x1': true }, '2025-01'), 1);
+  assert.equal(share.seasonQuestsDone({ 'w:2025-W01:w-x1': true }, '2024-12'), 0);
+  assert.equal(share.seasonQuestsDone({ 'w:2026-W53:w-x1': true }, '2026-12'), 1);
+  assert.equal(share.seasonQuestsDone({ 'w:2026-W53:w-x1': true }, '2027-01'), 0);
+  // odd input never throws and counts nothing
+  assert.equal(share.seasonQuestsDone(null, '2026-11'), 0);
+  assert.equal(share.seasonQuestsDone('junk', '2026-11'), 0);
+  assert.equal(share.seasonQuestsDone(claimed, 'November'), 0);
+  assert.equal(share.seasonQuestsDone(claimed, undefined), 0);
+  assert.equal(share.seasonQuestsDone({ 'w:2026-W99:x': true, 'd:2026-11-xx:y': true, __proto__: { 'd:2026-11-01:a-b': true } }, '2026-11'), 0);
+});
