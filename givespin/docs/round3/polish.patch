+      check(await noSideways(p), label + ': all 61 do not scroll the page sideways');
+      await p.close();
+    }
+    check(problems.length === problems0, 'section 35f: no console errors, warnings or failed requests', problems.slice(problems0, problems0 + 5));
+  }
+}
