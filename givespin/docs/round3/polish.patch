+test('every quest says where it is done: a real page of the site, or nowhere only when it is done on the Quests page itself', () => {
+  const app = SRC('app.js');
+  const pages = (/var PAGES = \[([^\]]*)\]/.exec(app)[1].match(/'([a-z-]+)'/g) || []).map((x) => x.replace(/'/g, ''));
+  const routes = new Set(['lobby', 'live'].concat(pages, ['originals', 'slots', 'table', 'races', 'instant'].map((c) => 'lobby-' + c)));
+  assert.ok(routes.has('spotlights') && routes.has('fair') && routes.has('lobby-slots'), 'the route list was read: ' + [...routes].join());
+  const ids = Q.DAILY.concat(Q.WEEKLY).map((t) => t.id);
+  assert.deepEqual(Object.keys(Q.LINKS).sort(), ids.slice().sort(), 'every quest has an entry, and nothing else does');
+  ids.forEach((id) => {
+    const href = Q.linkOf(id);
+    if (href === '') { assert.equal(id, 'w-dailies5', id + ' has nowhere to go'); return; }
+    assert.match(href, /^#[a-z-]+$/, id);
+    assert.ok(routes.has(href.slice(1)), id + ' goes to #' + href.slice(1) + ', which is not a page of the site');
+  });
+  assert.equal(Q.linkOf('d-spotlight'), '#spotlights', 'back the charity of the week goes to its page');
+  assert.equal(Q.linkOf('w-spotlight'), '#spotlights');
+  assert.equal(Q.linkOf('d-live'), '#live');
+  assert.equal(Q.linkOf('d-verify'), '#fair');
+  assert.equal(Q.linkOf('d-games2'), '#lobby');
+  assert.equal(Q.linkOf('nonsense'), '');
+  assert.equal(Q.linkOf('toString'), '', 'an id that is a property of every object is not a quest');
+});
