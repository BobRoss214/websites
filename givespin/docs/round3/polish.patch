+    'w-charities8': '#lobby', 'w-days4': '#lobby', 'w-games5': '#lobby', 'w-causes4': '#lobby', 'w-spotlight': '#spotlights', 'w-live3': '#live', 'w-verify2': '#fair',
+    'w-streak5': '#lobby', 'w-cup': '#leagues', 'w-dailies5': ''
