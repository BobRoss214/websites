+test('the time to the next local midnight: the same wherever the clock is, and right on the days a clock changes', () => {
+  const HOUR = 3600000;
+  const cases = [
+    ['UTC', [2026, 11, 4, 12, 0, 0], 12 * HOUR],
+    ['UTC', [2026, 11, 4, 23, 59, 59], 1000],
+    ['UTC', [2026, 11, 4, 0, 0, 0], 24 * HOUR],
+    ['Asia/Kolkata', [2026, 11, 4, 18, 30, 0], 5.5 * HOUR],
+    ['America/New_York', [2026, 3, 8, 0, 30, 0], 22.5 * HOUR],      // spring forward: that day has 23 hours
+    ['America/New_York', [2026, 11, 1, 0, 30, 0], 24.5 * HOUR],     // fall back: that day has 25 hours
+    ['Europe/London', [2026, 3, 29, 0, 30, 0], 22.5 * HOUR],        // the day loses an hour at 01:00 (23 hours long)
+    ['Europe/London', [2026, 3, 29, 12, 0, 0], 12 * HOUR],          // after the change it is plain again
+    ['Pacific/Auckland', [2026, 4, 5, 0, 30, 0], 24.5 * HOUR]       // the day gains an hour at 03:00 (25 hours long)
+  ];
+  cases.forEach(([tz, a, want]) => zone(tz, () => {
+    assert.equal(Q.msToMidnight(at(...a)), want, tz + ' ' + a.join(':'));
+    const now = at(...a);
+    assert.equal(new Date(now.getTime() + Q.msToMidnight(now)).getHours(), 0, tz + ': it lands on 00:00');
+    assert.equal(new Date(now.getTime() + Q.msToMidnight(now)).getMinutes(), 0);
+    assert.notEqual(core.dayKey(new Date(now.getTime() + Q.msToMidnight(now))), core.dayKey(now), tz + ': and it is the next day');
+  }));
+  assert.ok(Q.msToMidnight(new Date()) > 0 && Q.msToMidnight(new Date()) <= 25 * HOUR, 'never more than a day, never zero or negative');
+});
