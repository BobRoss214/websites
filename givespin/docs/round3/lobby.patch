--- base/givespin/css/walk.css	2026-11-04 06:26:51.939686042 +0000
+++ work/givespin/css/walk.css	2026-11-04 19:41:25.057624100 +0000
@@ -115,3 +115,53 @@
 /* ------------------------------------------------------------------ the lobby's quests line */
 /* "Ends in 27 days. 2 rewards to claim" broke between the number and its words on a phone (the "2" ended one line, "rewards to claim" began the next). The pair stays together. */
 .qblock__ready { white-space: nowrap; }
+
+/* ==========================================================================
+   The lobby's first screen: a game tile must show without scrolling (lobby helper, round 3)
+   After the four blocks moved under the tiles, the welcome banners (284 to 490 px tall), the house-edge strip and the Live tables strip (274 px) still stood above the tiles,
+   so on every window up to 1366 x 768 the first tile started below the first screen. Now: smaller banners, one row of category chips on a phone, and the two strips (and, on a short
+   window, the banners) under the first row of tiles (js/ui/lobby.js, placeExtras moves the same nodes; the words and links are unchanged).
+   ========================================================================== */
+
+/* the things that move into the tile grid take a whole row of it */
+.tiles > .promos, .tiles > .housestrip, .tiles > .livestrip { grid-column: 1 / -1; min-width: 0; margin: 0; }
+.tiles > .promos { padding-bottom: 0; }
+
+/* ------------------------------------------------------------------ the welcome banners, smaller (up to 1500 px wide, or on a short laptop window; a big screen keeps the roomy ones) */
+@media (max-width: 1500px), (max-height: 820px) {
+  .promo { grid-template-columns: minmax(0, 1fr); gap: 0; min-height: 0; padding: 14px 16px; border-radius: 16px; }
+  .promo__copy { gap: 6px; }
+  /* the picture sits in the top corner, beside the small heading, instead of taking a column of its own */
+  .promo__art { position: absolute; top: 12px; right: 12px; width: 58px; height: 58px; }
+  .promo__art svg { width: 100%; height: 100%; margin: 0; }
+  .promo__eyebrow, .promo__t { padding-right: 62px; }
+  .promo__t { font-size: 1.08rem; }
+  .promo__p { font-size: 0.8rem; max-width: none; }
+  .promos { gap: 12px; }
+  .promos + .housestrip { margin-top: 10px; }
+  .lobbybar { margin-top: 16px; }
+}
+
+/* ------------------------------------------------------------------ a phone: one row for the category chips, and the search box a little closer to what is under it */
+@media (max-width: 720px), (max-width: 920px) and (max-height: 520px) {
+  .lobbysearch { margin-bottom: 10px; }
+  .lobbybar { flex-wrap: nowrap; gap: 8px; margin: 12px 0 10px; }
+  /* the chips scroll sideways inside their own row (the page does not); the Filters and Repeat buttons stay at the right */
+  .cats { flex: 1 1 auto; min-width: 0; flex-wrap: nowrap; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; padding: 2px 2px 4px; }
+  .cats::-webkit-scrollbar { display: none; }
+  .cat { flex: none; }
+  .lobbybar__right { flex: none; flex-wrap: nowrap; }
+  /* "Repeat last round" is an icon here (its words stay for a screen reader and as the tooltip); it is switched off, and so hidden, until a round has been played */
+  .lobbybar__right [data-role="repeat"] { padding-inline: 10px; }
+  .lobbybar__right [data-role="repeat"] .lbl { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+  .lobbybar__right [data-role="repeat"]:disabled { display: none; }
+}
+
+/* a phone held sideways (up to 920 x 520): the tiles are as many to a row as fit (they were two, 330 px wide and 390 px tall, so the first tile filled the whole screen) */
+@media (max-width: 920px) and (max-height: 520px) {
+  .tiles { grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); gap: 10px; }
+  .lobbysearch { margin-bottom: 8px; }
+  .lobbybar { margin: 8px 0 8px; }
+  .cats { padding-bottom: 2px; }
+  .cat { padding: 6px 14px; }
+}
