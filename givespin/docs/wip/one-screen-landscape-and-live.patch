+#view-game.is-live .lt-pred > summary { padding: 8px 10px; font-size: 0.8rem; }
+#view-game.is-live .lt-pred__rows { gap: 6px; padding: 0 10px 10px; }
+#view-game.is-live .lt-toggles { gap: 4px 14px; }
+#view-game.is-live .lt-chat { padding: 8px 10px; }
+#view-game.is-live .lt-fine { margin-top: 0; font-size: 0.7rem; }
+#view-game.is-live .lt-stagebar__last { color: var(--red); font-weight: 800; }
+
+/* ------------------------------------------------ two columns wide (a laptop, a desktop): a sticky column, the foot pinned at the bottom of it */
+@media (min-width: 901px) {
+  #view-game.is-live #livepanel { position: sticky; top: calc(var(--top-h) + 12px); align-self: start; max-height: calc(100vh - 150px); }
+  /* "Live table" still names the panel for a screen reader; the words are not needed on the screen (the stage title says "Live") */
+  #view-game.is-live #livepanel .bet__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  /* the odds board shows the first few charities and scrolls inside itself; the rest of the panel's body is under it */
+  #view-game.is-live .odds { max-height: clamp(200px, calc(100vh - 560px), 440px); }
+}
+
+/* ------------------------------------------- a short window (a laptop with a small window, a phone held sideways): less page above the picture */
