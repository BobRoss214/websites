+  #view-game.is-live .crumbs { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  #view-game.is-live .crumbs:focus-within { position: fixed; z-index: 66; left: 8px; top: calc(var(--top-h) + 6px); width: auto; height: auto; margin: 0; padding: 4px 12px; overflow: visible; clip: auto; border-radius: 10px; background: var(--panel-2); border: 1px solid var(--line-2); box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.7); }
+}
