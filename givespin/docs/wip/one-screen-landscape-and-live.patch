+  #view-game.is-live .lt-other label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+  #view-game.is-live .lt-oddsfield .field__row { flex-wrap: nowrap; }
+  #view-game.is-live .lt-oddsfield .field__label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  #view-game.is-live .lt-oddsfield .field__row .btn { flex: none; white-space: nowrap; }
+  #view-game.is-live .bet .playbtn { padding: 6px 12px; }
