+  #view-game .dcard { height: 122px; width: clamp(96px, 28vh, 124px); gap: 4px; padding: 6px; }
+  #view-game .dcard__badge { width: 40px; font-size: 1rem; }
+  /* Dice: a flatter table, and the face numbers stay readable */
+  #view-game .dice__table { height: 112px; }
+  #view-game .dice__scene { --ds: clamp(52px, 15vh, 68px); --hop-h: 22px; }
+}
+@media (max-height: 760px) {
+  #view-game .dtile__n { width: 24px; height: 24px; font-size: 0.85rem; }   /* the number that joins a face of the die to its charity: it was 22 px and shrank with the picture */
