+  }
+  /* shut: only the foot (the stake presets, Options, join); open: the body above it, which scrolls, with the foot kept at the bottom of the sheet */
+  #view-game.is-live #livepanel:not(.is-more) .lt-scroll { display: none; }
+  #view-game.is-live #livepanel:not(.is-more) .lt-stake .field__row { display: none; }
+  #view-game.is-live .lt-foot { margin: 0; padding: 0; border: 0; background: transparent; }
+  #view-game.is-live #livepanel.is-more .lt-foot { margin-top: 2px; padding-top: 8px; border-top: 1px solid var(--line); }
+  #view-game.is-live #livepanel.is-more .lt-scroll { padding-bottom: 8px; }
+  /* the clock stays at the top of the sheet while the body scrolls under it (a control reached with the keyboard is scrolled clear of it) */
+  #view-game.is-live .lt-status { position: sticky; top: 0; z-index: 2; margin: 0 -2px; padding: 4px 2px 6px; background: var(--panel); }
+  #view-game.is-live .lt-scroll { scroll-padding-top: 48px; }
+  /* in the sheet the odds board is as long as it is (the sheet scrolls, the board does not scroll inside it) */
+  #view-game.is-live .odds { max-height: none; }
+  /* the stake presets look like the solo gift panel's: five buttons in a row (they wrap when a high level adds the VIP stakes) */
+  #view-game.is-live #lt-stake { gap: 6px; padding: 0; border: 0; border-radius: 0; background: transparent; }
+  #view-game.is-live #lt-stake .seg__btn { flex: 1 1 52px; min-height: 36px; border: 1px solid var(--line-2); border-radius: 9px; background: var(--panel-2); }
+  #view-game.is-live #lt-stake .seg__btn:hover:not(:disabled):not([aria-pressed="true"]) { border-color: #4a7392; }
+  #view-game.is-live #lt-stake .seg__btn[aria-pressed="true"] { border-color: var(--green); background: rgba(34, 240, 122, 0.12); box-shadow: none; }
+  #view-game.is-live .tbtn { height: 40px; }
+  /* Options and join side by side */
+  #view-game.is-live .bet__act { display: flex; align-items: stretch; gap: 8px; }
+  #view-game.is-live .bet__act .playbtn { flex: 1 1 auto; width: auto; min-width: 0; }
+  #view-game.is-live .bet__optbtn {
+    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; flex: none; min-width: 60px;
+    padding: 4px 8px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--panel-2); color: var(--muted); font: 700 0.66rem var(--f-body);
+  }
+  #view-game.is-live .bet__optbtn:hover { color: var(--text); border-color: #4a7392; }
+  #view-game.is-live .bet__optbtn[aria-expanded="true"] { color: var(--green); border-color: var(--green); background: rgba(34, 240, 122, 0.1); }
+}
+/* a phone: the navigation bar is at the bottom, so the dock sits on top of it; the header over the picture takes less room */
+@media (max-width: 720px) and (min-height: 521px), (max-width: 560px) {
+  #view-game.is-live #livepanel { left: 0; bottom: var(--nav-h); }
+  #view-game.is-live .stage { gap: 6px; padding: 8px 10px 10px; }
+  #view-game.is-live .stage__head { flex-wrap: nowrap; align-items: center; gap: 8px; }
+  #view-game.is-live .stage__title { font-size: 1rem; line-height: 1.2; }
+  /* "Checkable result" is a shield on its own here (its words are still in the page for a screen reader, and in its tooltip) */
+  #view-game.is-live #stage-fair { font-size: 0; line-height: 0; gap: 0; padding: 5px 7px; }
+  #view-game.is-live #stage-fair .ico { width: 17px; height: 17px; }
+}
+@media (max-width: 599px) {
+  /* the round and the pot on two lines that keep their shape as the clock ticks (a Marble Run table's track is named at the end of the first line) */
+  #view-game.is-live .lt-stagebar { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "a m" "b b"; gap: 0 10px; padding: 5px 10px; font-size: 0.74rem; line-height: 1.35; border-radius: 10px; }
+  #view-game.is-live .lt-stagebar__a { grid-area: a; }
+  #view-game.is-live .lt-stagebar__m { grid-area: m; order: 0; flex: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  #view-game.is-live .lt-stagebar__b { grid-area: b; }
 }
