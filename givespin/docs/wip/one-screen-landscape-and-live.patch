+}
+/* (the demo strip is two lines up to about 620 px wide, so the panel starts lower: it is a little shorter to stay clear of the bar at the bottom) */
+@media (min-width: 561px) and (max-width: 620px) and (max-height: 520px) {
+  #view-game.is-live #livepanel { height: calc(100vh - var(--top-h) - 54px - var(--nav-h)); }
+}
+
+/* ------------------------------------ one column (a phone, a tablet held upright): the panel docked at the bottom of the screen */
+@media (max-width: 900px) and (min-height: 521px), (max-width: 560px) {
+  #view-game.is-live #livepanel {
+    position: fixed; z-index: 65; right: 0; left: var(--side-w); bottom: 0; margin: 0;
+    padding: 6px 12px 8px; border-width: 1px 0 0; border-radius: 14px 14px 0 0;
+    box-shadow: 0 -14px 30px -12px rgba(0, 0, 0, 0.65);
