+}
+@media (max-height: 760px) and (max-width: 560px) {
+  /* Last One Standing: two columns of tiles on a phone (one column of eight rows was too tall) */
+  #view-game .stand__grid--sm { --min: 128px; }
+}
+
+/* ---------- a window up to 520 px tall (a phone held sideways): the games with real text and buttons are drawn smaller by their own sizes ----------
+   About 200 to 250 px of height is left for the picture there. Sizes that follow the height of the window (vh) keep each game's words and buttons usable;
+   whatever is still too big is shrunk by css/fit.css. */
