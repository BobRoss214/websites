diff --git a/tests/games.test.mjs b/tests/games.test.mjs
index 5f6424c..87b1117 100644
--- a/tests/games.test.mjs
+++ b/tests/games.test.mjs
@@ -440,2 +440,22 @@ await run('games', async ({ browser, base, errs }) => {
   lap('10 320 px');
+  // ---- 10b. the Sunflower Whisperer badge without the mouse (the sunflowers are out of reach on a phone): the "Pick a blueberry" button snips one every fourth press, and they grow back in 3 to 5 seconds
+  {
+    const p = await page(1440, 900);
+    await season(p, 'summer');
+    await p.evaluate(() => { const f = document.querySelector('#hero-scene .flower-cut'); f.dispatchEvent(new MouseEvent('click', { bubbles: true })); window.__flower = f; });
