+    await p.clock.fastForward(5200);
+    ok('sunflower: it is back after 5 seconds', (await p.evaluate(() => window.__flower.dataset.state)) === undefined);
+    let presses = 0;
+    for (; presses < 1200; presses++) {   // the blueberry badge comes first (about the 130th press); the sunflower one about the 400th
+      await p.evaluate(() => document.getElementById('pick-btn').click());
+      const t = await toast(p);
+      if (t && t.cls === 'ach-sunflower') break;
+      if (presses % 20 === 19) await p.clock.fastForward(6500);   // the snipped sunflowers grow back, a badge on screen closes
+    }
+    await okSoon(`sunflower: the button alone earns the badge (${presses + 1} presses)`, () => toast(p), (t) => t && t.cls === 'ach-sunflower' && t.title === 'Sunflower Whisperer');
+    await p.context().close();
+  }
+  lap('10b sunflower button');
+
   // ---- 11. the badge for accessibility tools (when axe-core is installed)
