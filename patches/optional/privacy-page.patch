+++ b/tests/privacy-page.test.mjs
@@ -0,0 +1,99 @@
+/* The privacy page (privacy.html, built from pages/privacy.html): it exists, every page links to it and the sitemap lists it, every sentence on it is in
+ * docs/PRIVACY_PAGE_EVIDENCE.md (which says where the code shows it), the facts it states still match the code and the settings, and its two sets of
+ * visit-counter sentences switch correctly (no counter: the first set; a counter really runs: the second set; Do Not Track or a half-filled setting: the
+ * first set again), in English and in another language. The reading and storage facts themselves are tested by tests/privacy.test.mjs. Needs a browser. */
+import fs from 'node:fs';
+import path from 'node:path';
+import { run, open, ok, info, ROOT } from './lib.mjs';
+
+const read = (f) => fs.readFileSync(path.join(ROOT, f), 'utf8');
+const has = (f) => fs.existsSync(path.join(ROOT, f));
+const decode = (s) => s.replace(/&rsquo;/g, '’').replace(/&lsquo;/g, '‘').replace(/&ldquo;/g, '“').replace(/&rdquo;/g, '”').replace(/&mdash;/g, '—').replace(/&ndash;/g, '–').replace(/&nbsp;/g, ' ').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
+const plainQuotes = (s) => s.replace(/[\u2018\u2019]/g, "'").replace(/[\u201c\u201d]/g, '"');   // the page has curly quotes, the document may have straight ones
+const text = (html) => plainQuotes(decode(html.replace(/<[^>]+>/g, ''))).replace(/\s+/g, ' ').trim();
+
+/* ---------------------------------------------------------------- 1. the files (no browser needed) */
+ok('pages/privacy.html is built into privacy.html (run python3 tools/pages.py)', has('pages/privacy.html') && has('privacy.html') && /<h1[^>]*>What this website keeps and shares<\/h1>/.test(read('privacy.html')));
+const src = read('pages/privacy.html').replace(/^\s*---[\s\S]*?\n---\s*\n/, '');
+const blocks = [];
+for (const tag of ['h1', 'h2', 'h3', 'p', 'summary']) for (const m of src.matchAll(new RegExp(`<${tag}\\b[^>]*>([\\s\\S]*?)</${tag}>`, 'g'))) blocks.push(text(m[1]));
+for (const m of src.matchAll(/<li\b[^>]*>([\s\S]*?)<\/li>/g)) if (!/<(p|h3|ul|li)\b/.test(m[1])) blocks.push(text(m[1]));
+const evidence = text(read('docs/PRIVACY_PAGE_EVIDENCE.md'));
+const missingFromEvidence = blocks.filter((b) => b && !evidence.includes(b));
+ok(`every one of the ${blocks.length} pieces of text on the page is in docs/PRIVACY_PAGE_EVIDENCE.md (with the code or test that shows it)`, blocks.length > 30 && missingFromEvidence.length === 0, missingFromEvidence.slice(0, 3).join(' | '));
+const rows = [...read('docs/PRIVACY_PAGE_EVIDENCE.md').matchAll(/^\| P\d\d \| (.+?) \| (.+?) \| (.+?) \|$/gm)];
+const said = (c, n) => c.trim().length > n || /^(As|The same as) P\d\d/.test(c.trim());   // "As P02." points to the row that has the evidence
+ok('every sentence row of the evidence document names where it comes from and how it was checked', rows.length >= 40 && rows.every((r) => said(r[2], 12) && said(r[3], 5)), rows.filter((r) => !(said(r[2], 12) && said(r[3], 5))).map((r) => r[1].slice(0, 30)).join(' | '));
+
+const pagesHtml = fs.readdirSync(ROOT).filter((f) => f.endsWith('.html') && f !== '404.html');
+const noLink = pagesHtml.filter((f) => !/<a\b[^>]*href="privacy\.html"/.test(read(f)));
+ok(`every page links to the privacy page in its footer (${pagesHtml.length} pages)`, pagesHtml.length >= 7 && noLink.length === 0, noLink.join(', '));
+ok('sitemap.xml lists the privacy page, and robots.txt does not block it', /<loc>https:\/\/www\.wiseacresorganic\.com\/privacy\.html<\/loc>/.test(read('sitemap.xml')) && !/Disallow:\s*\/privacy/.test(read('robots.txt')));
+
+/* the number of new texts the patch says it brings (header "Strings:", the two doc rows) is the number the page really has */
+{
+  const idsOf = (html) => new Set([...html.matchAll(/\bdata-(?:t|ta-[a-z-]+)="(t[0-9a-f]{8})"/g)].map((m) => m[1]));
+  const footerLink = /<li><a [^>]*href="privacy\.html"[^>]*>[^<]*<\/a><\/li>/g;   // the one footer line the other pages gain from this patch
+  const others = new Set(); for (const f of pagesHtml.filter((x) => x !== 'privacy.html')) for (const id of idsOf(read(f).replace(footerLink, ''))) others.add(id);
+  const fresh = [...idsOf(read('privacy.html'))].filter((id) => !others.has(id));   // the texts of the page and the footer link ("Privacy"); a text the page shares with another page is already translated
+  const js = has('lang/js-strings.json') ? Object.keys(JSON.parse(read('lang/js-strings.json'))) : [];
+  const meta = read('pages/privacy.html').match(/^title:\s*(.+)$/m), desc = read('pages/privacy.html').match(/^description:\s*(.+)$/m);
+  const scriptTexts = [meta && meta[1].trim(), desc && desc[1].trim()].filter((t) => t && js.includes(t)).length;
+  const total = fresh.length + scriptTexts;
+  const PATCH = 'patches/optional/privacy-page.patch';
+  if (has(PATCH)) {
+    const said = (/^Strings:\s*(\d+) new texts per language/m.exec(read(PATCH)) || [])[1];
+    ok(`the patch header says ${said} new texts per language: the page and footer have ${fresh.length} and the page's title and description are ${scriptTexts}, ${total} in all`, Number(said) === total, `header ${said}, found ${total}`);
