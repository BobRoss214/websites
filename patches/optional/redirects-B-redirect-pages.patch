diff --git a/js/moved.js b/js/moved.js
new file mode 100644
index 0000000..13effec
--- /dev/null
+++ b/js/moved.js
@@ -0,0 +1,66 @@
+/* The words of the "this page has moved" pages (the folders about/, faq/, food/ ... of patches/optional/redirects-B-redirect-pages.patch).
+ *
+ *   - Those pages are English in their HTML, and they jump to the right place at once (<meta http-equiv="refresh">, and a link for a browser that does not).
+ *     Their two lines carry data-t ids like every other page, so tools/i18n.py extracts them and the translations are in lang/src/<code>.json.
+ *   - This file puts the lines in the visitor's language, the way js/i18n.js does it: ?lang=xx in the address, else the language saved with the language button
+ *     (wa.lang; saved English stays English), else, when the visitor never chose and never said "No, thanks" to the offer (wa.offer), the first language of the
+ *     browser's list that the site has. The home page itself only OFFERS that language (it has the offer bar); this page has no room for one, so it just speaks it.
+ *   - No flash of English: while the words of another language are on their way the text is hidden (html.moved-wait, set here, and styled in the page), and shown
+ *     again the moment they are in. If the file does not arrive, or has nothing for these lines, the English is shown (and after 3 seconds at the latest).
+ *   - Without JavaScript nothing of this runs: the page is English, the meta refresh and the link work as before.
+ *   - The address the page jumps to is not touched here. */
+(() => {
+  'use strict';
+  const doc = document;
+  const W = (window.WISE_ACRES = window.WISE_ACRES || {});
+  const HTML = { es: 'es', hi: 'hi', zh: 'zh-Hans', vi: 'vi' };   // the languages of js/i18n.js, with the lang attribute each one needs
+  const known = (c) => Object.prototype.hasOwnProperty.call(HTML, c);
+  const stored = (k) => { try { return localStorage.getItem(k); } catch (e) { return null; } };
+
+  function pick() {
+    const q = /[?&]lang=([a-z]{2})\b/i.exec(location.search);
+    if (q) return known(q[1].toLowerCase()) ? q[1].toLowerCase() : 'en';
+    const saved = stored('wa.lang');
+    if (saved) return known(saved) ? saved : 'en';
+    if (stored('wa.offer')) return 'en';
+    const prefs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']).map((x) => String(x).toLowerCase().slice(0, 2));
+    return prefs.find(known) || 'en';
+  }
+
+  const code = pick();
+  if (code === 'en') return;
+  const root = doc.documentElement;
+  root.classList.add('moved-wait');
+  const show = () => root.classList.remove('moved-wait');
+  setTimeout(show, 3000);
+
+  function translate() {
+    const d = W.dict && W.dict[code] && W.dict[code].ui;
+    let n = 0;
+    if (d) {
+      doc.querySelectorAll('[data-t]').forEach((el) => {
+        const t = d[el.getAttribute('data-t')];
+        if (typeof t === 'string' && t) { el.innerHTML = t; n++; }
+      });
+    }
+    if (n) {
+      root.lang = HTML[code];
+      const first = doc.querySelector('[data-t]');
+      if (first) doc.title = first.textContent + ' | Wise Acres Organic Farm';
+    }
+    show();
+  }
+
+  W.dict = W.dict || {};
+  if (doc.readyState === 'loading') {
+    // Parser-blocking on purpose, as in js/i18n.js: the words are there before the first line is drawn.
+    doc.write('<script src="/lang/' + code + '.js"><\/script>');
+    doc.addEventListener('DOMContentLoaded', translate);
+  } else {
+    const s = doc.createElement('script');
+    s.src = '/lang/' + code + '.js';
+    s.onload = translate;
+    s.onerror = show;
+    (doc.head || root).appendChild(s);
+  }
+})();
