   // data-only="fall winter": shown only while one of those seasons is on screen. Add data-in-season to show it only
   // while that season is really happening (not in the weeks before or after, when the nearest season is shown).
   // data-out-of-season="spring" is the opposite: hidden while that season is really happening ("Tell me when it opens").
+  // data-book (optional, the owner's choice): a Reserve button shows only inside the booking window the site's own words give.
+  // data-book="spring" is about that season; data-book with no value follows the season on screen. The FAQ ("When do
+  // reservations open?") says strawberry reservations open "usually a few weeks before the season starts", read here as
+  // 3 weeks, and close when the season ends. Summer and fall state no window, so their buttons are never hidden by this.
+  const BOOK_LEAD_DAYS = { spring: 21 };
+  function bookable(id) {
+    const s = W.seasons.list.find((x) => x.id === id), lead = BOOK_LEAD_DAYS[id];
+    if (!s || lead === undefined) return true;
+    const n = new Date(), t = new Date(n.getFullYear(), n.getMonth(), n.getDate()), st = s.start(t.getFullYear());
+    return t >= new Date(st.getFullYear(), st.getMonth(), st.getDate() - lead) && t <= s.end(t.getFullYear());
+  }
   function applyOnly(id) {
     const now = W.seasons.live().map((s) => s.id), live = now.includes(id);
     $$('[data-only]').forEach((el) => el.toggleAttribute('hidden', !el.dataset.only.split(/\s+/).includes(id) || (el.hasAttribute('data-in-season') && !live)));   // SVG elements have no .hidden property
     $$('[data-out-of-season]').forEach((el) => el.toggleAttribute('hidden', el.dataset.outOfSeason.split(/\s+/).some((s) => now.includes(s))));
+    $$('[data-book]').forEach((el) => {
+      const ok = bookable(el.dataset.book || id);
+      if (el.hasAttribute('data-only')) { if (!ok) el.hidden = true; } else el.hidden = !ok;
+    });
+    const bar = $('#action-bar');   // the phone bar keeps its buttons evenly spread when one is hidden
+    if (bar) bar.dataset.count = String($$('a, button', bar).filter((a) => !a.hidden).length);
   }
 
   function build(id) {
