__pycache__/
*.pyc
*.orig
*.rej

# The private box of Python packages some computers need (README, "Commands on Windows, Mac and Linux", step 4)
.venv/

# Baseline made by tests/visual-check.mjs on each developer's own computer (not part of the repository)
tests/.visual/

# The upload folder made by tools/make_deploy_folder.py (made fresh each time)
deploy/

# The sheets for a native speaker, made on demand by tools/review_sheet.py (never kept: a stale sheet would undo newer translations)
review/

# Made by `npm install` in tests/ (see tests/README): never part of the repository
node_modules/
tests/package-lock.json

# Files computers and editors leave behind
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
